# ============================================================================
# FrontierAtlas Intelligence Pipeline Configuration
# ============================================================================

# LLM Provider API Keys & Fallback Settings
# Tier 1: Primary extraction
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_RPM=15

# Tier 2: Groq / Secondary OpenAI-compatible
GROQ_API_KEY=your_groq_api_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_RPM=30

# Tier 3: Third-Party OpenAI-Compatible Provider (e.g. DeepSeek V4 Flash / Custom Gateway)
CUSTOM_LLM_API_KEY=your_custom_api_key_here
CUSTOM_LLM_BASE_URL=https://api.deepseek.com
CUSTOM_LLM_MODEL=deepseek-chat
CUSTOM_LLM_RPM=60
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# LLM Concurrency Limit (Prevents hitting free tier RPM limits)
MAX_CONCURRENT_LLM_REQUESTS=5

# GitHub API Token (for live repository star metrics)
# For scale, GITHUB_TOKENS (comma-separated) pools multiple keys for star enrichment;
# GITHUB_TOKEN remains the single-key fallback.
GITHUB_TOKEN=your_github_token_here
GITHUB_TOKENS=

# Pipeline Operational Settings
MAX_CONCURRENT_REQUESTS=15
DEFAULT_REQUEST_TIMEOUT_SECONDS=30
TOKEN_BUDGET_PER_PROMPT=3500
LOG_LEVEL=INFO

# Crawler tuning (externalized for scale; defaults match prior hardcoded values)
ARXIV_INTERVAL_SECONDS=3.2
GITHUB_INTERVAL_SECONDS=2.1
GITHUB_ANONYMOUS_LOOKUP_BUDGET=50
PAPERS_BATCH_SIZE=500
OPENALEX_PER_PAGE=100
HF_DAILY_LIMIT=100
ARXIV_SEARCH_QUERY=(cat:cs.AI OR cat:cs.LG OR cat:cs.CV OR cat:cs.CL) AND (all:github OR all:code)
ARXIV_CDN_CATEGORIES=cs.AI,cs.LG,cs.CV,cs.CL,cs.NE
OPENALEX_EMAIL=
PRODUCTS_CONCURRENCY=15
YC_START_PAGE=2
YC_MAX_PAGE=24
YC_PARALLEL_PAGES=4
GITHUB_SEARCH_PAGES=10
HF_MODELS_LIMIT=1000
WAL_DIR=exports/wal

# LLM timeouts (seconds)
LLM_CALL_TIMEOUT_SECONDS=10.0
LLM_EXTRACT_TIMEOUT_SECONDS=12.0
# Optional LLM key pools (comma-separated); falls back to the single keys above
GEMINI_API_KEYS=
GROQ_API_KEYS=
CUSTOM_LLM_API_KEYS=
DEEPSEEK_API_KEYS=

# News/job source knobs
NEWS_SUMMARY_PREVIEW_LEN=300
NEWS_SUMMARY_MAX_LEN=500
JOBS_REMOTEOK_URL=https://remoteok.com/api?tag=ai
JOBS_ARBEITNOW_URL=https://www.arbeitnow.com/api/job-board-api
JOBS_HIMALAYAS_API_URL=https://himalayas.app/jobs/api?q=ai
JOBS_HIMALAYAS_RSS_URL=https://himalayas.app/jobs/rss
JOBS_WEWORKREMOTELY_URLS=https://weworkremotely.com/remote-jobs.rss|https://weworkremotely.com/categories/remote-programming-jobs.rss|https://weworkremotely.com/categories/remote-customer-support-jobs.rss
JOBS_HNRSS_URL=https://hnrss.org/whoishiring/jobs?q=AI
# Optional JSON source-list overrides: [{"name": "X", "url": "https://..."}, ...] / [{"name": "X", "feed_url": "https://..."}]
PRODUCT_SOURCES_JSON=
NEWS_SOURCES_JSON=

# Write-ahead log checkpointing: auto-enabled for targets >= 1000; force on/off for any target
ENABLE_WAL=false

# Optional Google Sheets Deliverable Export (gspread service account)
GOOGLE_SERVICE_ACCOUNT_PATH=credentials/service-account.json
# Alias accepted by effective_service_account_path (primary takes precedence)
GOOGLE_SHEETS_CREDENTIALS_PATH=
GOOGLE_SHEETS_SPREADSHEET_ID=
EVALUATOR_EMAIL=evaluator@example.com
# Rows per values_update batch; tune against the Sheets write quota at scale
SHEETS_BATCH_SIZE=500

# Cross-run novelty state file (tests MUST override to a temp path)
RUN_STATE_PATH=exports/run_state.json
